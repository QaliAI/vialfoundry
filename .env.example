# Supabase Credentials (Dedicated Vial Foundry Project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Payment Processor Adapter Settings
PAYMENT_GATEWAY_TYPE=sandbox # options: sandbox, stripe, authnet, NMI
PAYMENT_API_KEY=your-payment-api-key
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# Transactional Email Settings
RESEND_API_KEY=re_your_resend_key
TRANSACTIONAL_EMAIL_FROM=support@vialfoundry.com
NOTIFICATION_EMAIL_TO=admin@vialfoundry.com

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://vialfoundry.com
