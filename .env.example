# Supabase Credentials (Dedicated Vial Foundry Project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Payments
#
# Development / Vercel Preview: TEST Stripe keys only.
# Vercel Production: LIVE Stripe keys only.
# Never put live and test secret keys in the same environment.
# Never expose STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET via NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY_TYPE=stripe
NEXT_PUBLIC_PAYMENT_GATEWAY_TYPE=stripe

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SITE_URL=https://www.vialfoundry.com

# Optional manual methods. Leave blank to hide. Do not use placeholder handles.
NEXT_PUBLIC_CASHAPP_CASHTAG=
NEXT_PUBLIC_ZELLE_HANDLE=
NEXT_PUBLIC_NOWPAYMENTS_LINK=
NEXT_PUBLIC_LINKMONEY_LINK=

# Local QA only. Marks submitted orders as test. NEVER set in production.
NEXT_PUBLIC_QA_TEST_ORDERS=

# ---------------------------------------------------------------------------
# Email (Resend) — server-side only for RESEND_API_KEY
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_SENDER_NAME=Vial Foundry
EMAIL_SENDER_DOMAIN=vialfoundry.com
TRANSACTIONAL_EMAIL_FROM=Vial Foundry <orders@vialfoundry.com>
TRANSACTIONAL_EMAIL_REPLY_TO=support@vialfoundry.com

NEXT_PUBLIC_HELLO_EMAIL=hello@vialfoundry.com
NEXT_PUBLIC_INFO_EMAIL=info@vialfoundry.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@vialfoundry.com

ADMIN_NOTIFICATION_EMAIL=
NOTIFICATION_EMAIL_TO=

# Admin
ADMIN_EMAIL=
ADMIN_ACCESS_PASSWORD=
ADMIN_SESSION_SECRET=
