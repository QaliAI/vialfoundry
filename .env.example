# Supabase Credentials (Dedicated Vial Foundry Project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Payment Processor Adapter Settings
PAYMENT_GATEWAY_TYPE=sandbox # options: sandbox, stripe, authnet, NMI

# Stripe Checkout. All three are required before PAYMENT_GATEWAY_TYPE=stripe
# will actually activate; with any of them missing the app falls back to the
# sandbox adapter and card payments stay disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYMENT_API_KEY=your-payment-api-key
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# Transactional Email Settings
RESEND_API_KEY=re_your_resend_key
TRANSACTIONAL_EMAIL_FROM=support@vialfoundry.com
NOTIFICATION_EMAIL_TO=admin@vialfoundry.com

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://vialfoundry.com

# Payment method handles (shown to customers at checkout)
NEXT_PUBLIC_CASHAPP_CASHTAG=$YourCashtag
NEXT_PUBLIC_ZELLE_HANDLE=payments@vialfoundry.com
NEXT_PUBLIC_NOWPAYMENTS_LINK=your-nowpayments-hosted-link
NEXT_PUBLIC_LINKMONEY_LINK=your-link-money-payment-link

# Local QA only. Marks submitted orders as test so they are excluded from
# revenue reporting. NEVER set this in production.
NEXT_PUBLIC_QA_TEST_ORDERS=
